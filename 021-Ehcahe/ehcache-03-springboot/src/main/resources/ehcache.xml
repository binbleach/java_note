<?xml version="1.0" encoding="UTF-8"?>
<ehcache xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://ehcache.org/ehcache.xsd">
        <!-- 指定⼀个⽂件⽬录，当EHCache把数据写到硬盘上时，将把数据写到这个⽂件⽬录下 -->
        <diskStore path="java.io.tmpdir/ehcache"/>
        <!-- 默认缓存 -->
        <!-- 设定缓存的默认数据过期策略 -->
        <defaultCache
        maxElementsInMemory="10000"
        eternal="false"
        timeToIdleSeconds="120"
        timeToLiveSeconds="120"
        maxElementsOnDisk="10000000"
        diskExpiryThreadIntervalSeconds="120"
        memoryStoreEvictionPolicy="LRU">
        </defaultCache>
        <!--
            设定具体的命名缓存的数据过期策略
            1、cache元素的属性：
            2、name：缓存名称
            3、maxElementsInMemory：内存中最⼤缓存对象数
            4、maxElementsOnDisk：硬盘中最⼤缓存对象数，若是0表示⽆穷⼤
            5、eternal：true表示对象永不过期，此时会忽略timeToIdleSeconds和
            6、timeToLiveSeconds属性，默认为false
            7、overflowToDisk：true表示当内存缓存的对象数⽬达到了maxElementsInMemory界限
               后，会把溢出的对象写到硬盘缓存中。注意：如果缓存的对象要写⼊到硬盘中的话，则该对象必须实现
            了Serializable接⼝才⾏。
            8、diskSpoolBufferSizeMB：磁盘缓存区⼤⼩，默认为30MB。每个Cache都应该有⾃⼰的
               ⼀个缓存区。
            9、diskPersistent：是否缓存虚拟机重启期数据
            10、diskExpiryThreadIntervalSeconds：磁盘失效线程运⾏时间间隔，默认为120秒
            11、timeToIdleSeconds： 设定允许对象处于空闲状态的最⻓时间，以秒为单位。当对象⾃
               从最近⼀次被访问后，如果处于空闲状态的时间超过了timeToIdleSeconds属性值，这个对象就会
               过期，EHCache将把它从缓存中清空。只有当eternal属性为false，该属性才有效。如果该属性值
               为0，则表示对象可以⽆限期地处于空闲状态
            12、timeToLiveSeconds：设定对象允许存在于缓存中的最⻓时间，以秒为单位。当对象⾃从
                被存放到缓存中后，如果处于缓存中的时间超过了 timeToLiveSeconds属性值，这个对象就会过
                期，EHCache将把它从缓存中清除。只有当eternal属性为false，该属性才有效。如果该属性值为
                0，则表示对象可以⽆限期地存在于缓存中。timeToLiveSeconds必须⼤于timeToIdleSeconds属
                性，才有意义
            13、memoryStoreEvictionPolicy：当达到maxElementsInMemory限制时，Ehcache将会
               根据指定的策略去清理内存。可选策略有：LRU（最近最少使⽤，默认策略）、FIFO（先进先出）、
               LFU（最少访问次数）。
        -->

        <!-- helloworld缓存 -->
        <cache name="UserCache"
        maxElementsInMemory="1000"
        eternal="false"
        timeToIdleSeconds="5"
        timeToLiveSeconds="5"
        overflowToDisk="false"
        memoryStoreEvictionPolicy="LRU"/>
</ehcache>