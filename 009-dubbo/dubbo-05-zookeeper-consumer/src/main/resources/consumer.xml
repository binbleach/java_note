<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dubbo="http://dubbo.apache.org/schema/dubbo"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd http://dubbo.apache.org/schema/dubbo http://dubbo.apache.org/schema/dubbo/dubbo.xsd">

    <dubbo:application name="dubbo-05-zookeeper-consumer"/>

    <dubbo:registry address="zookeeper://192.168.8.128:2181"/>

    <dubbo:reference id="userService" interface="com.huangjiabin.service.UserService"/>

    <!--多个服务接收-->
    <dubbo:reference id="userService2" interface="com.huangjiabin.service.UserService" version="2.0.0"/>
</beans>